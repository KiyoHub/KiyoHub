local function applyXRay(enable)
    task.spawn(function()
        pcall(function()
            if enable then
                OriginalXRayTransparency = {}
                local chars = {}
                if LocalPlayer.Character then chars[#chars + 1] = LocalPlayer.Character end
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character then chars[#chars + 1] = p.Character end
                end
                local all = workspace:GetDescendants()
                for i = 1, #all do
                    local part = all[i]
                    if part:IsA("BasePart") then
                        local isPlayerPart = false
                        for c = 1, #chars do
                            if part:IsDescendantOf(chars[c]) then isPlayerPart = true break end
                        end
                        if not isPlayerPart then
                            OriginalXRayTransparency[part] = part.LocalTransparencyModifier
                            part.LocalTransparencyModifier = 0.9
                        end
                    end
                end
            else
                for part, origTrans in pairs(OriginalXRayTransparency) do
                    if part and part.Parent then part.LocalTransparencyModifier = origTrans end
                end
                OriginalXRayTransparency = {}
            end
        end)
    end)
end


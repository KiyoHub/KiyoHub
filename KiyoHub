                P("ball", "Sole", V(0.58, 0.1, 1.12), white, SP, "knee" .. sdn, T(0, -1.78, -0.2))
            end

            -- âm thanh SIUUU
            local sound = Instance.new("Sound")
            sound.Name = "Siu"
            sound.SoundId = "rbxassetid://7681560017"
            sound.Volume = 5
            sound.RollOffMaxDistance = 150
            sound.Parent = r.root

            local form = { center = 3.8, stride = 0.5, speed = 25 }
            -- đang SIU thì đứng yên (tốc độ 0), xong mới chạy lại tốc độ 25
            form.getSpeed = function()
                if siuT >= 0 then return 0 end
                return 25
            end
            form.update = function(dt)
                local t, m, ph, fa, air = M.t, M.m, M.phase, M.fa, M.air
                local idle = (1 - m) * (1 - fa) * (1 - air)

                -- diễn biến cú ăn mừng SIU
                local yaw, w, spreadK = 0, 0, 0
                if siuT >= 0 then
                    siuT = siuT + dt
                    local total = 0.55 + siuHold + 0.45
                    if siuT >= total then
                        siuT = -1
                    else
                        if siuT < 0.55 then
                            yaw = pi * smooth(siuT / 0.55)
                        elseif siuT < 0.55 + siuHold then
                            yaw = pi
                        else
                            yaw = pi * (1 - smooth((siuT - 0.55 - siuHold) / 0.45))
                        end
                        w = min(smooth(siuT / 0.25), smooth((total - siuT) / 0.4))
                        spreadK = smooth((siuT - 0.4) / 0.25)
                    end
                end

                local ak = air * (1 - w)
                local fk = fa * (1 - w)

                local armOut = lerp(0.5, 0.12, m)
                local inw = lerp(1.6, 0, m)
                local flex = lerp(0, 1.25, m)
                local armAmp = 0.85 * m
                local legAmp = 0.95 * m
                local lean = 0.03 + 0.17 * m
                local hpA = 0.1
                local hy = sin(t * 0.6) * 0.3 * idle
                local splay = 0.07 * idle
                local twist = 0.2 * m * sin(ph)
                local roll = 0.03 * sin(t * 0.9) * idle

                lean = lerp(lean, 0.25 + 0.5 * M.fs, fk)
                if w > 0 then
                    armOut = lerp(armOut, lerp(0.85, 1.25, spreadK), w)
                    inw = lerp(inw, 0, w)
                    flex = lerp(flex, lerp(1.0, 0.12, spreadK), w)
                    armAmp = lerp(armAmp, 0, w)
                    lean = lerp(lean, lerp(0.05, -0.2, spreadK), w)
                    hpA = lerp(hpA, lerp(0.05, 0.28, spreadK), w)
                    hy = lerp(hy, 0, w)
                    splay = lerp(splay, 0.22 * spreadK, w)
                    twist = lerp(twist, 0, w)
                end

                B.pelvis = T(0, 3.75, 0) * Ry(twist) * Rz(roll)
                B.chest = B.pelvis * T(0, 0.1, 0) * Rx(-(lean + 0.012 * sin(t * 1.8))) * Ry(-twist * 1.5)
                B.head = B.chest * T(0, 2.15, 0) * Rx(hpA) * Ry(hy)

                for _, sx in ipairs(SIDES) do
                    local sdn = sd(sx)
                    -- tay
                    local aOut = lerp(armOut, 0.85, ak)
                    local aSw = -sx * armAmp * sin(ph)
                    local aInw = lerp(inw, 0, ak)
                    local aFlex = lerp(flex, 0.8, ak)
                    aOut = lerp(aOut, 0.06, fk)
                    aSw = lerp(aSw, 2.2, fk)
                    aInw = lerp(aInw, 0, fk)
                    aFlex = lerp(aFlex, 0.1, fk)
                    B["arm" .. sdn .. "S"] = B.chest * T(sx * 1.1, 1.6, 0) * Rz(sx * aOut) * Rx(aSw)
                    B["arm" .. sdn .. "E"] = B["arm" .. sdn .. "S"] * T(0, -1.4, 0) * Rz(-sx * aInw) * Rx(aFlex)
                    B["arm" .. sdn .. "H"] = B["arm" .. sdn .. "E"] * T(0, -1.35, 0)

                    -- chân
                    local sw = sx * legAmp * sin(ph)
                    local bend = m * (0.2 + 1.0 * max(0, sx * cos(ph + 0.3)))
                    sw = lerp(sw, (sx == 1) and 0.7 or -0.35, ak)
                    bend = lerp(bend, (sx == 1) and 1.2 or 0.5, ak)
                    sw = lerp(sw, -0.25, fk)
                    bend = lerp(bend, 0.35, fk)
                    if w > 0 then
                        sw = lerp(sw, 0.35 * (1 - spreadK), w)
                        bend = lerp(bend, 0.9 * (1 - spreadK) + 0.12 * spreadK, w)
                    end
                    B["leg" .. sdn] = T(sx * 0.42, 3.65, 0) * Rz(sx * splay) * Rx(sw)
                    B["knee" .. sdn] = B["leg" .. sdn] * T(0, -1.8, 0) * Rx(-bend)
                end

                return 0.12 * abs(cos(ph)) * m * (1 - w), yaw
            end
            form.action = {
                text = "SIU", cd = 0.5,
                fn = function()
                    if siuT >= 0 then return end
                    siuT = 0
                    pcall(function()
                        sound.TimePosition = 0
                        sound:Play()
                    end)
                    pcall(function()
                        local len = sound.TimeLength
                        siuHold = (len and len > 0) and clamp(len - 0.6, 1.2, 3.2) or 2.0
                    end)
                    pcall(function()
                        if not M.fly and r.hum.FloorMaterial ~= Enum.Material.Air then
                            r.hum:ChangeState(Enum.HumanoidStateType.Jumping)
                        end
                    end)
                end
            }
            return form
        end

        -- =====================================================================
        --  CÁ (chỉ sống trong nước / chỗ bơi được; lên cạn bị trừ 10 máu mỗi giây)
        -- =====================================================================
        Forms.Fish = function(r, H)

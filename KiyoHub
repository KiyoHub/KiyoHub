        local faceAcc = 0
        table.insert(Connections, RunService.Heartbeat:Connect(function(dt)
            if not N.guide and #N.chasers == 0 and #N.mangos == 0 then return end
            local t = os.clock()
            local myHrp, myHum = getMyHrp()

            local g = N.guide
            if g then
                if g.hrp.Parent and g.hum.Health <= 0 then
                    -- Davo's Mango bị giết: biến mất hẳn (bật lại công tắc để gọi lại)
                    pcall(N.clearGuide)
                elseif g.hrp.Parent then
                    if g.chasing then
                        if t - g.born > 60 or g.hrp.Position.Y < -300 then
                            N.endGuideChase()
                        else
                            chaseStep(g, t, dt, myHrp, myHum)
                        end
                    else
                        driveAnim(g, false, 0)
                        if g.animReady and g.useProc then procPose(g, t) end
                        faceAcc = faceAcc + dt
                        if myHrp and faceAcc > 0.15 then
                            faceAcc = 0
                            local p = g.hrp.Position
                            g.hrp.CFrame = CF(p, V3(myHrp.Position.X, p.Y, myHrp.Position.Z))
                        end
                    end
                else
                    N.guide = nil
                end
            end

            for i = #N.chasers, 1, -1 do
                local c = N.chasers[i]
                if not c.hrp.Parent or c.hum.Health <= 0 or t - c.born > 60 or c.hrp.Position.Y < -300 then
                    removeChaser(i)
                else
                    chaseStep(c, t, dt, myHrp, myHum)
                end
            end

            -- xoài đang bay
            if #N.mangos > 0 then
                for _, mg in ipairs(N.mangos) do mg.dt = dt end
                stepMangos(t, myHrp, myHum)
            end
        end))

        -- hồi sinh (kể cả đổi R6/R15): NPC đuổi đánh biến mất, NPC hướng dẫn dựng lại theo rig mới
        table.insert(Connections, LocalPlayer.CharacterAdded:Connect(function()
            N.clearChasers()
            if N.guide then
                task.delay(1.5, function()
                    if Running and N.guide and N.summon then pcall(N.summon) end
                end)
            end
        end))

        -- cầu nối: rồng phun lửa gây dame cho Lê Thô Sơ + davos
        local bridgeEnv = (getgenv and getgenv()) or _G
        bridgeEnv.KiyoHubNPC = {
            -- đấm cận chiến của Quái Vật: trúng Davo's Mango (dù đang đứng yên hay đang dí) + Lê Thô Sơ; trả về số NPC bị trúng
            hitMelee = function(origin, dir, range, dmg)
                local list, hits = {}, 0
                for i = 1, #N.chasers do list[#list + 1] = N.chasers[i] end
                -- Davo's Mango lúc đứng bình thường thì không đánh được, chỉ trúng khi đang dí
                if N.guide and N.guide.chasing then list[#list + 1] = N.guide end
                for i = 1, #list do
                    local c = list[i]
                    if c and c.hrp and c.hrp.Parent and c.hum and c.hum.Health > 0 then
                        local to = c.hrp.Position - origin
                        local flat = V3(to.X, 0, to.Z)
                        if flat.Magnitude <= range and math.abs(to.Y) < 8
                            and (flat.Magnitude < 3 or flat.Unit:Dot(dir) > 0.4) then
                            pcall(function() c.hum:TakeDamage(dmg) end)
                            hits = hits + 1
                        end
                    end
                end
                return hits
            end,
            -- tiếng gào của Quái Vật: gần (<= nearR) trừ nearDmg, vừa (<= midR) trừ midDmg; davo chỉ dính khi đang dí
            hitAura = function(origin, nearR, midR, nearDmg, midDmg)
                local list = {}
                for i = 1, #N.chasers do list[#list + 1] = N.chasers[i] end
                if N.guide and N.guide.chasing then list[#list + 1] = N.guide end
                for i = 1, #list do
                    local c = list[i]
                    if c and c.hrp and c.hrp.Parent and c.hum and c.hum.Health > 0 then
                        local to = c.hrp.Position - origin
                        local d = V3(to.X, 0, to.Z).Magnitude
                        if math.abs(to.Y) < 12 then
                            if d <= nearR then
                                pcall(function() c.hum:TakeDamage(nearDmg) end)
                            elseif d <= midR then
                                pcall(function() c.hum:TakeDamage(midDmg) end)
                            end
                        end
                    end
                end
            end,
            hitCone = function(origin, dir, range, dmg)
                local list = {}
                for i = 1, #N.chasers do list[#list + 1] = N.chasers[i] end
                if N.guide and N.guide.chasing then list[#list + 1] = N.guide end
                for i = 1, #list do
                    local c = list[i]
                    if c and c.hrp and c.hrp.Parent and c.hum and c.hum.Health > 0 then
                        local to = c.hrp.Position - origin
                        local proj = to:Dot(dir)
                        if proj > 0 and proj <= range then
                            local perp = (to - dir * proj).Magnitude
                            if perp <= 6 + proj * 0.2 then
                                pcall(function() c.hum:TakeDamage(dmg) end)
                            end
                        end
                    end
                end
            end
        }

        table.insert(CleanupFns, function()
            pcall(function() bridgeEnv.KiyoHubNPC = nil end)
            pcall(N.clear)
            pcall(function() if N.folder then N.folder:Destroy() end end)
            pcall(function() dlg:Destroy() end)
        end)
    end)
    if not okGuide then warn("[KiyoHub] Lỗi khối NPC hướng dẫn: " .. tostring(errGuide)) end
end


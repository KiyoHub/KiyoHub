    local function playExtraEmote(key, entry)
        local _, hum = getChar()
        if not hum then return end
        if hum.RigType ~= Enum.HumanoidRigType.R15 then
            notify("Emote này chỉ dùng được cho R15.")
            return
        end
        activeKey, startedAt = key, os.clock()
        refreshButtons()
        local myToken = playToken
        task.spawn(function()
            local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 2)
            if not animator then
                if myToken == playToken then activeKey = nil refreshButtons() end
                notify("Không tải được emote.")
                return
            end

            -- danh sách ID animation có thể dùng (đã biết trước, hoặc dò từ ID catalog)
            local candidates = {}
            if entry.resolved then
                candidates[1] = entry.resolved
            else
                if entry.catalog and game.GetObjects then
                    pcall(function()
                        local objs = game:GetObjects("rbxassetid://" .. entry.catalog)
                        for _, o in ipairs(objs) do
                            local found = {}
                            if o:IsA("Animation") then found[#found + 1] = o end
                            for _, d in ipairs(o:GetDescendants()) do
                                if d:IsA("Animation") then found[#found + 1] = d end
                            end
                            for _, a in ipairs(found) do
                                local n = tostring(a.AnimationId):match("%d+")
                                if n then candidates[#candidates + 1] = n end
                            end
                            pcall(function() o:Destroy() end)
                        end
                    end)
                end
                if entry.id then candidates[#candidates + 1] = tostring(entry.id) end
                if entry.catalog then candidates[#candidates + 1] = tostring(entry.catalog) end
            end
            if myToken ~= playToken then return end

            local track = nil
            for _, idStr in ipairs(candidates) do
                local okLoad, tr = pcall(function()
                    local anim = Instance.new("Animation")
                    anim.AnimationId = "rbxassetid://" .. idStr
                    return animator:LoadAnimation(anim)
                end)
                if okLoad and tr then
                    local t0 = os.clock()
                    while tr.Length <= 0 and os.clock() - t0 < 3 do task.wait(0.1) end
                    if tr.Length > 0 then
                        track = tr
                        entry.resolved = idStr -- nhớ ID đã chạy được cho lần sau
                        break
                    end
                    pcall(function() tr:Destroy() end)
                end
                if myToken ~= playToken then return end
            end

            if myToken ~= playToken then
                if track then pcall(function() track:Destroy() end) end
                return
            end
            if not track then
                activeKey = nil
                refreshButtons()
                notify("Emote này không tải được (emote trả phí có thể cần sở hữu).")
                return
            end
            pcall(function()
                track.Priority = Enum.AnimationPriority.Action
                track.Looped = entry.loop
                track:Play(0.2)
            end)
            currentTrack = track
            startedAt = os.clock()
        end)
    end


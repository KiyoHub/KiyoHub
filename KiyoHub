local MainScale = Instance.new("UIScale", MainFrame)
MainScale.Scale = 1
local menuToggleId = 0

-- nhớ vị trí cuộn: khi menu thu nhỏ/phóng to, kích thước canvas bị tính lại làm vị trí cuộn bị kẹp về 0
local ScrollRegistry = {}
local ScrollMemory = {}
local function RememberScrolls()
    if MainScale.Scale < 0.99 then return end -- đang giữa animation thì giữ bản đã nhớ trước đó
    for _, sf in ipairs(ScrollRegistry) do
        if sf.Parent then ScrollMemory[sf] = sf.CanvasPosition end
    end
end
local function RestoreScrolls()
    for _, sf in ipairs(ScrollRegistry) do
        local pos = ScrollMemory[sf]
        if pos and sf.Parent then
            local maxY = math.max(0, sf.AbsoluteCanvasSize.Y - sf.AbsoluteWindowSize.Y)
            sf.CanvasPosition = Vector2.new(pos.X, math.min(pos.Y, maxY))
        end
    end
end

FloatButton.MouseButton1Click:Connect(function()
    menuToggleId = menuToggleId + 1
    local myId = menuToggleId
    if not MainFrame.Visible then
        MainScale.Scale = 0.02
        MainFrame.Visible = true
        TweenService:Create(MainScale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
        task.defer(RestoreScrolls)
        task.delay(0.1, function() if myId == menuToggleId then RestoreScrolls() end end)
        task.delay(0.3, function() if myId == menuToggleId then RestoreScrolls() end end)
    else
        RememberScrolls()
        TweenService:Create(MainScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.02}):Play()
        task.delay(0.12, function()
            if myId ~= menuToggleId then return end
            MainFrame.Visible = false
            MainScale.Scale = 1
        end)
    end
end)


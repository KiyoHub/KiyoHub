        local function hideObj(d)
            if rig and d:IsDescendantOf(rig.folder) then return end
            if d:IsA("BasePart") then
                if d.Name == "HumanoidRootPart" or d:FindFirstAncestorOfClass("Tool") then return end
                if hidden[d] == nil then hidden[d] = d.Transparency end

        -- ===================== AI đuổi đánh dùng chung (Lê Thô Sơ + davo khi dí) =====================
        -- nếu NPC bị ngã / nghiêng / ragdoll thì dựng dậy ngay (giữ nguyên hướng nhìn)
        local BAD_STATES = {
            [Enum.HumanoidStateType.FallingDown] = true,
            [Enum.HumanoidStateType.Ragdoll] = true,
            [Enum.HumanoidStateType.Physics] = true,
            [Enum.HumanoidStateType.PlatformStanding] = true,
        }
        local function stabilize(c, force)
            local hum, hrp = c.hum, c.hrp
            if not (hum and hrp and hrp.Parent) then return end
            local bad = force or hum.PlatformStand or hum.Sit or hrp.CFrame.UpVector.Y < 0.85
            if not bad then
                local ok, st = pcall(function() return hum:GetState() end)
                bad = ok and BAD_STATES[st] == true
            end
            if not bad then return end
            pcall(function()
                hum.PlatformStand, hum.Sit = false, false
                local p, look = hrp.Position, hrp.CFrame.LookVector
                local flat = V3(look.X, 0, look.Z)
                if flat.Magnitude < 0.05 then flat = V3(0, 0, -1) end
                local up = p + V3(0, 0.6, 0)
                hrp.CFrame = CF(up, up + flat.Unit)
                hrp.AssemblyAngularVelocity = V3(0, 0, 0)
                hrp.AssemblyLinearVelocity = V3(0, 0, 0)
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
        end

        local function chaseStep(c, t, dt, myHrp, myHum)
            stabilize(c)
            local v = c.hrp.AssemblyLinearVelocity
            local speed = V3(v.X, 0, v.Z).Magnitude
            c.walk = c.walk + ((speed > 2 and 1 or 0) - c.walk) * 0.25
            driveAnim(c, c.walk > 0.5, speed)
            if c.animReady and c.useProc then procPose(c, t) end

            if myHrp and myHum and myHum.Health > 0 then
                local mp, cp = myHrp.Position, c.hrp.Position
                local d = V3(mp.X - cp.X, 0, mp.Z - cp.Z).Magnitude
                if c.isDavos and d > 6 and d < 90 and t - c.mangoLast >= MANGO_COOLDOWN then
                    -- chỉ ném khi không có tường chắn giữa davo và mày; bị chắn thì thử lại sau 0.5s
                    local from = c.head.Position
                    local blocked = castWorld(from, (myHrp.Position + V3(0, 0.5, 0)) - from)
                    if blocked then
                        c.mangoLast = t - MANGO_COOLDOWN + 0.5
                    else
                        c.mangoLast = t
                        pcall(throwMango, c, myHrp)
                    end
                end
                if d > 3.8 then
                    c.hum:MoveTo(mp)
                    -- chỉ nhảy khi bị kẹt vật cản (không nhảy theo mày)
                    if speed < 2 and t - c.born > 1 then c.stuck = c.stuck + dt else c.stuck = 0 end
                    if c.stuck > 0.4 then
                        c.hum.Jump = true
                        c.stuck = 0
                    end
                else
                    c.stuck = 0
                    c.hum:MoveTo(cp)
                    c.hrp.CFrame = CF(cp, V3(mp.X, cp.Y, mp.Z))
                    if t - c.last >= 0.9 then
                        c.last = t
                        doPunch(c, t)
                        if math.abs(mp.Y - cp.Y) < 6 then
                            pcall(function() myHum:TakeDamage(10) end)
                        end
                    end
                end
            end
        end

        -- Davo's Mango (NPC hướng dẫn) tự dí đánh mày 60 giây rồi quay lại làm NPC hướng dẫn
        N.startGuideChase = function()
            local g = N.guide
            if not g or g.chasing or not g.hrp.Parent then return end
            g.chasing, g.isDavos = true, true
            g.born, g.last, g.stuck, g.walk = os.clock(), 0, 0, 0
            g.mangoLast = os.clock() - (MANGO_COOLDOWN - 1.5) -- quả xoài đầu tiên sau ~1.5s
            pcall(function()
                noFall(g.hum)
                for _, d in ipairs(g.model:GetDescendants()) do
                    if d:IsA("BasePart") then
                        d.AssemblyLinearVelocity = V3(0, 0, 0)
                        d.AssemblyAngularVelocity = V3(0, 0, 0)
                    end
                end
                local p = g.hrp.Position
                local at = V3(p.X, groundAt(p) + rigLift(g), p.Z)
                local mp = getMyHrp()
                local face = mp and V3(mp.Position.X, at.Y, mp.Position.Z) or (at + g.hrp.CFrame.LookVector)
                g.model:PivotTo(CF(at, face))
            end)
            g.hrp.Anchored = false
            task.defer(function()
                pcall(function()
                    if g.hrp.Parent then g.hum:ChangeState(Enum.HumanoidStateType.Running) end
                end)
            end)
            pcall(function() g.hum.WalkSpeed = 17 end)

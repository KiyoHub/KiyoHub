local function updateIntro(alpha)
    local ui = IntroUI
    if not ui.Card then return end
    local t = os.clock()
    local curve = 1 - math.pow(1 - alpha, 3)
    local percent = math.clamp(math.floor(curve * 100), 0, 100)

    ui.Percent.Text = percent .. "%"
    ui.Fill.Size = UDim2.new(curve, 0, 1, 0)
    ui.Head.Position = UDim2.new(curve, 0, 0.5, 0)
    ui.FillGrad.Offset = Vector2.new(math.sin(t * 2.2) * 0.5, 0)
    ui.StrokeGrad.Rotation = (t * 80) % 360
    ui.RingGrad.Rotation = (t * 260) % 360

    local pulse = 0.5 + 0.5 * math.sin(t * 3)
    ui.Glow.BackgroundTransparency = 0.78 + 0.14 * pulse
    local gs = 68 + 10 * pulse
    ui.Glow.Size = UDim2.new(0, gs, 0, gs)

    if percent < 30 then
        ui.Status.Text = "Loading core modules..."
    elseif percent < 65 then
        ui.Status.Text = "Preparing interface..."
    elseif percent < 95 then
        ui.Status.Text = "Optimizing performance..."
    else
        ui.Status.Text = "Ready!"
    end
end


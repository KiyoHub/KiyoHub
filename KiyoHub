        local mangoRP = RaycastParams.new()
        mangoRP.FilterType = Enum.RaycastFilterType.Exclude
        local function castWorld(from, vec)
            local ex = { N.folder }
            if LocalPlayer.Character then ex[#ex + 1] = LocalPlayer.Character end
            for _ = 1, 4 do
                mangoRP.FilterDescendantsInstances = ex
                local hit = Workspace:Raycast(from, vec, mangoRP)
                if not hit then return nil end
                local p = hit.Instance
                if p.CanCollide or p.Transparency < 0.9 then return hit end
                ex[#ex + 1] = p -- vùng kích hoạt vô hình: xuyên qua
            end
            return nil
        end

        -- davos ném xoài về phía mình
        local MANGO_SPEED, MANGO_DAMAGE, MANGO_COOLDOWN = 80, 15, 5
        local function throwMango(c, myHrp)
            ensureFolder()
            doPunch(c, os.clock())
            local toMe = myHrp.Position - c.hrp.Position
            if toMe.Magnitude < 0.1 then return end
            local origin = c.head.Position + toMe.Unit * 1.5 + V3(0, 0.3, 0)
            local flight = (myHrp.Position - origin).Magnitude / MANGO_SPEED
            local lead = myHrp.AssemblyLinearVelocity * math.min(flight, 1) * 0.8
            local aim = myHrp.Position + V3(lead.X, 0, lead.Z) + V3(0, 0.5, 0)
            local vel = (aim - origin).Unit * MANGO_SPEED

            local m = Instance.new("Part")
            m.Name = "DavosMango"
            m.Size, m.Color, m.Material = V3(1.2, 1.6, 1.2), Color3.fromRGB(255, 170, 30), Enum.Material.SmoothPlastic
            m.Anchored, m.CanCollide, m.CanQuery, m.CanTouch, m.Massless = true, false, false, false, true
            m.TopSurface, m.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
            local mesh = Instance.new("SpecialMesh")
            mesh.MeshType = Enum.MeshType.Sphere
            mesh.Parent = m
            m.CFrame = CF(origin)
            local leaf = Instance.new("Part")
            leaf.Name = "MangoLeaf"
            leaf.Size, leaf.Color = V3(0.25, 0.12, 0.7), Color3.fromRGB(40, 140, 50)
            leaf.CanCollide, leaf.CanQuery, leaf.CanTouch, leaf.Massless = false, false, false, true
            leaf.TopSurface, leaf.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
            leaf.Parent = m
            local w = Instance.new("Weld")
            w.Part0, w.Part1, w.C0 = m, leaf, CF(0.2, 0.85, 0) * CFrame.Angles(0, 0.6, 0.4)
            w.Parent = leaf
            m.Parent = N.folder
            table.insert(N.mangos, { part = m, pos = origin, vel = vel, born = os.clock() })
        end

        local function stepMangos(t, myHrp, myHum)
            for i = #N.mangos, 1, -1 do
                local mg = N.mangos[i]
                local dead = false
                if not mg.part.Parent or t - mg.born > 4 then
                    dead = true
                else
                    local newPos = mg.pos + mg.vel * (mg.dt or 0.016)
                    local hit = castWorld(mg.pos, newPos - mg.pos)
                    local endPos = hit and hit.Position or newPos
                    if myHrp and myHum and myHum.Health > 0 then
                        local s = endPos - mg.pos
                        local len2 = s:Dot(s)
                        local k = (len2 > 0) and math.clamp((myHrp.Position - mg.pos):Dot(s) / len2, 0, 1) or 0
                        if ((mg.pos + s * k) - myHrp.Position).Magnitude < 3.2 then
                            pcall(function() myHum:TakeDamage(MANGO_DAMAGE) end)
                            dead = true
                        end
                    end
                    if not dead then
                        if hit then
                            dead = true
                        else
                            mg.pos = newPos
                            mg.part.CFrame = CF(newPos) * CFrame.Angles(t * 8, t * 5, 0)
                        end
                    end
                end
                if dead then removeMango(i) end
            end
        end


local function hitboxApply(p)
    if p ~= LocalPlayer and p.Character then
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            if not OriginalHitboxSizes[hrp] then OriginalHitboxSizes[hrp] = hrp.Size end
            -- chỉ ghi khi giá trị khác (ghi thuộc tính vật lý mỗi frame rất tốn)
            if hrp.Size ~= hbSize then hrp.Size = hbSize end

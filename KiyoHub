local function getClosestPlayerToHead()
    local closestPlayer = nil
    local shortestDistance = math.huge
    pcall(function()
        local myChar = LocalPlayer.Character
        if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
        local myHrp = myChar.HumanoidRootPart
        local myTeam = LocalPlayer.Team and LocalPlayer.Team.Name or ""

        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                if p.Character:FindFirstChildOfClass("ForceField") then
                    continue
                end

                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then
                    continue
                end

                local state = hum:GetState()
                if state == Enum.HumanoidStateType.Dead or state == Enum.HumanoidStateType.Physics or hum.PlatformStand then
                    continue
                end

                local targetTeam = p.Team and p.Team.Name or ""
                
                if targetTeam == myTeam and myTeam ~= "" then
                    continue
                end

                local shouldTarget = false

                if isPrisonLife then
                    local isDangerous = checkPrisonLifeThreat(p)

                    if myTeam == "Criminals" then
                        if targetTeam == "Guards" then shouldTarget = true
                        elseif targetTeam == "Inmates" and isDangerous then shouldTarget = true end
                    elseif myTeam == "Guards" then
                        if targetTeam == "Criminals" then shouldTarget = true
                        elseif targetTeam == "Inmates" and isDangerous then shouldTarget = true end
                    elseif myTeam == "Inmates" then
                        if targetTeam == "Guards" or targetTeam == "Criminals" then shouldTarget = true
                        elseif targetTeam == "Inmates" and isDangerous then shouldTarget = true end
                    else
                        if p.Team ~= LocalPlayer.Team then shouldTarget = true end
                    end
                else
                    if p.Team ~= LocalPlayer.Team then
                        shouldTarget = true
                    elseif myTeam == "" or not p.Team then
                        shouldTarget = true
                    end
                end

                if not shouldTarget then
                    continue
                end

                local head = p.Character:FindFirstChild("Head")
                if head then
                    local rayParams = RaycastParams.new()
                    rayParams.FilterType = Enum.RaycastFilterType.Exclude
                    rayParams.FilterDescendantsInstances = {myChar, p.Character}
                    rayParams.IgnoreWater = true
                    
                    local origin = Camera.CFrame.Position
                    local direction = head.Position - origin
                    local rayResult = workspace:Raycast(origin, direction, rayParams)
                    
                    if not rayResult then
                        local dist = (head.Position - myHrp.Position).Magnitude
                        if dist < shortestDistance then 
                            shortestDistance = dist 
                            closestPlayer = p 
                        end
                    end
                end
            end
        end
    end)
    return closestPlayer
end


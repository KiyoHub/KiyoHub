            if hrp.CanCollide then hrp.CanCollide = false end
        end
    end
end

local function slapIsMover(child)
    return child:IsA("BodyVelocity") or child:IsA("BodyThrust") or child:IsA("LinearVelocity") or child:IsA("VectorVelocity") or child:IsA("BodyForce") or child:IsA("BodyGyro") or child:IsA("BodyPosition") or child:IsA("AlignPosition") or child:IsA("VectorForce") or child:IsA("Torque")
end


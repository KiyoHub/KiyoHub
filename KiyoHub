        local function buildRig(char, formName)
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not (hrp and hum) then return nil end

            -- khoảng cách từ tâm HumanoidRootPart xuống mặt đất (R15 và R6 khác nhau)
            local groundOffset
            if hum.RigType == Enum.HumanoidRigType.R15 then
                groundOffset = hum.HipHeight + hrp.Size.Y / 2
            else
                local torso, leg = char:FindFirstChild("Torso"), char:FindFirstChild("Left Leg")
                groundOffset = (torso and torso.Size.Y / 2 or 1) + (leg and leg.Size.Y or 2)
            end

            local folder = Instance.new("Folder")
            folder.Name = "KiyoMorph"
            local root = Instance.new("Part")
            root.Name = "MorphRoot"
            root.Size = V(0.2, 0.2, 0.2)
            root.Transparency = 1
            root.CanCollide, root.CanQuery, root.CanTouch, root.Massless = false, false, false, true
            root.Parent = folder
            local rootWeld = Instance.new("Weld")
            rootWeld.Part0, rootWeld.Part1 = hrp, root
            rootWeld.C0 = T(0, -groundOffset, 0)
            rootWeld.Parent = root

            local r = { folder = folder, root = root, rootWeld = rootWeld, parts = {}, B = {}, hrp = hrp, hum = hum, groundOffset = groundOffset }
            local H = makeHelpers(r)
            local ok, form = pcall(Forms[formName], r, H)
            if not ok or not form then
                warn("[KiyoHub] Không dựng được hình " .. tostring(formName) .. ": " .. tostring(form))
                pcall(function() folder:Destroy() end)
                return nil
            end
            r.form = form
            return r
        end

        local function stepRig(dt)
            local r = rig
            if not r then return end
            local hrp, hum = r.hrp, r.hum
            if not (hrp and hrp.Parent and hum and hum.Parent) then return end
            -- màn hình 120-240Hz không cần cập nhật hàng trăm khớp weld mỗi frame: gộp lại ~65 lần/giây
            r.cap = (r.cap or 0) + dt
            if r.cap < 0.0153 then return end
            dt = r.cap
            r.cap = 0
            local form = r.form
            -- hình quá nhiều khối (rồng): khi bay chỉ cập nhật ~30 lần/giây để đỡ lag
            if form.flyHz and M.fa > 0.3 then
                r.acc = (r.acc or 0) + dt
                if r.acc < 1 / form.flyHz then return end
                dt = r.acc
                r.acc = 0
            else
                r.acc = 0
            end
            local t = os.clock()
            local v = hrp.AssemblyLinearVelocity
            local spd = Vector3.new(v.X, 0, v.Z).Magnitude
            local flyNow = (State.FlyActive == true)
            local grounded = hum.FloorMaterial ~= Enum.Material.Air

            M.t, M.dt, M.fly, M.vy = t, dt, flyNow, v.Y
            M.fa = M.fa + ((flyNow and 1 or 0) - M.fa) * (1 - exp(-dt * 5))
            M.air = M.air + ((((not grounded) and (not flyNow)) and 1 or 0) - M.air) * (1 - exp(-dt * 10))
            local target
            if flyNow then target = 0 elseif grounded then target = clamp(spd / 16, 0, 1.5) else target = 0.3 end
            M.moveAlpha = M.moveAlpha + (target - M.moveAlpha) * (1 - exp(-dt * 8))
            M.m = clamp(M.moveAlpha, 0, 1)
            M.phase = M.phase + dt * clamp(spd, 0, 40) * (form.stride or 0.65)
            local fsT = flyNow and clamp(v.Magnitude / max(tonumber(State.FlySpeed) or 65, 1), 0, 1) or 0
            M.fs = M.fs + (fsT - M.fs) * (1 - exp(-dt * 4))
            local av = hrp.AssemblyAngularVelocity.Y
            local bankT = flyNow and clamp(av * 0.12, -0.6, 0.6) or 0
            M.bank = M.bank + (bankT - M.bank) * (1 - exp(-dt * 5))

            -- tốc độ riêng của từng dạng (nếu mày đã tự chỉnh WalkSpeed khác 16 thì ưu tiên số của mày)
            local fs = form.getSpeed and form.getSpeed() or form.speed
            if fs and (fs == 0 or (tonumber(State.WalkSpeed) or 16) == 16) then
                if hum.WalkSpeed ~= fs then hum.WalkSpeed = fs end
                r.speedApplied = true
            elseif r.speedApplied then
                r.speedApplied = false
                hum.WalkSpeed = tonumber(State.WalkSpeed) or 16
            end

            local okU, bob, yaw = pcall(form.update, dt)
            if not okU then
                if not r.warned then
                    r.warned = true
                    warn("[KiyoHub] Morph update lỗi: " .. tostring(bob))
                end
                bob, yaw = 0, 0
            end

            local ry = -lerp(r.groundOffset, form.center, M.fa) + (bob or 0)
            r.rootWeld.C0 = T(0, ry, 0) * Ry(yaw or 0)

            local pcs = r.parts
            for i = 1, #pcs do
                local pc = pcs[i]
                local ok, cf = pcall(pc.f)
                if ok and cf and cf ~= pc.last then
                    pc.last = cf
                    pc.w.C0 = cf
                end
            end
        end

        local function enableMorph()
            destroyMorph()
            local char = LocalPlayer.Character
            if not char then return end
            local formName = Forms[State.MorphForm] and State.MorphForm or "Dog"
            local r = buildRig(char, formName)
            if not r then return end
            rig = r

            M.moveAlpha, M.m, M.phase, M.air, M.fs, M.bank = 0, 0, 0, 0, 0, 0
            M.fa = (State.FlyActive == true) and 1 or 0

            if r.form.autoFly then
                flyOwned = true
                setFlyState(true)
                pcall(function() SubFlyBtn.Visible = true end)
                M.fa = 1
            end

            pcall(stepRig, 0.016)
            r.folder.Parent = char
            for _, x in ipairs(char:GetDescendants()) do hideObj(x) end
            hideConn = char.DescendantAdded:Connect(function(x) pcall(hideObj, x) end)
            refreshAction()
        end

        table.insert(Connections, RunService.RenderStepped:Connect(function(dt)
            if not rig then return end
            pcall(stepRig, math.min(dt, 0.1))
        end))

        table.insert(Connections, LocalPlayer.CharacterAdded:Connect(function(char)
            if not State.Morph then return end
            task.spawn(function()
                char:WaitForChild("HumanoidRootPart", 5)
                task.wait(1)
                if State.Morph and Running and LocalPlayer.Character == char then enableMorph() end
            end)
        end))

        SubMorphBtn.MouseButton1Click:Connect(function()
            local a = rig and rig.form and rig.form.action
            if not a then return end
            if os.clock() - lastAction < (a.cd or 0.35) then return end
            lastAction = os.clock()
            pcall(a.fn)
        end)

        SubAtkBtn.MouseButton1Click:Connect(function()
            local a = rig and rig.form and rig.form.attack
            if not a then return end
            if os.clock() - lastAttack < (a.cd or 0.35) then return end
            lastAttack = os.clock()
            pcall(a.fn)
        end)

        VisualTab:CreateToggle({
            Name = "Morph",
            CurrentValue = State.Morph,
            Callback = function(Value)
                if Value then enableMorph() else destroyMorph() end
            end
        })

        VisualTab:CreateDropdown({
            Name = "MorphForm",
            Options = FormOrder,
            CurrentOption = Forms[State.MorphForm] and State.MorphForm or "Dog",
            Callback = function(Option)
                State.MorphForm = tostring(Option)
                if State.Morph then enableMorph() end
            end
        })

        table.insert(CleanupFns, destroyMorph)
    end)
    if not okMorph then warn("[KiyoHub] Lỗi khối Biến Hình: " .. tostring(errMorph)) end
end


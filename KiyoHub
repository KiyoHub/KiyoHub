    local PackOrder = {
        "Default", "Ninja", "Superhero", "Robot", "Zombie",
        "Levitation", "Cartoony", "Mage", "Toy", "Werewolf",
        "Vampire", "Elder", "Knight", "Stylish", "Astronaut",
        "Pirate", "Bubbly",
    }

    State.AnimPack = (tostring(State.AnimPack or "Default"):gsub(" %(R15 only%)", ""))

    local origIds = setmetatable({}, { __mode = "k" }) -- ID gốc của từng slot, để trả về Default
    local validCache = {}                               -- [id] = true/false (đã kiểm tra tải được chưa)
    local applyToken = 0

    local function notify(text)
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Kiyo Hub", Text = text, Duration = 5 })
        end)
    end

    local function getSlots(animate)
        local function slot(folder, name)
            local f = animate:FindFirstChild(folder)
            return f and f:FindFirstChild(name)
        end
        return {
            idle1 = slot("idle", "Animation1"), idle2 = slot("idle", "Animation2"),
            walk = slot("walk", "WalkAnim"), run = slot("run", "RunAnim"),
            jump = slot("jump", "JumpAnim"), fall = slot("fall", "FallAnim"),
            climb = slot("climb", "ClimbAnim"),
        }
    end

    -- kiểm tra ID có tải được thật không (tránh ID sai làm nhân vật đứng đơ)
    local function animLoads(animator, id)
        local ok, good = pcall(function()
            local a = Instance.new("Animation")
            a.AnimationId = "rbxassetid://" .. id
            local track = animator:LoadAnimation(a)
            local t0 = os.clock()
            while track.Length <= 0 and os.clock() - t0 < 4 do task.wait(0.1) end
            local result = track.Length > 0
            pcall(function() track:Destroy() end)
            a:Destroy()
            return result
        end)
        return ok and good
    end

    local function reloadAnimate(hum, animate)
        animate.Disabled = true
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do pcall(function() tr:Stop(0) end) end
        end
        task.wait()
        animate.Disabled = false
    end

    local function applyPack(packName)
        applyToken = applyToken + 1
        local myToken = applyToken
        task.spawn(function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            local animate = char:FindFirstChild("Animate") or char:WaitForChild("Animate", 5)
            if not animate then
                if packName ~= "Default" then notify("Game này không có script Animate, không đổi animation được.") end
                return
            end
            local pack = AnimPacks[packName]
            if pack and hum.RigType ~= Enum.HumanoidRigType.R15 then
                notify("Gói animation này chỉ dùng được cho R15.")
                return
            end

            local slots = getSlots(animate)
            local changed = false

            -- trả mọi slot về ID gốc trước khi áp gói mới
            for _, slot in pairs(slots) do
                if origIds[slot] then
                    slot.AnimationId = origIds[slot]
                    origIds[slot] = nil
                    changed = true
                end
            end

            local failed = 0
            if pack then
                local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 3)
                if animator then
                    local pending = 0
                    for key, id in pairs(pack) do
                        if slots[key] and validCache[id] == nil then
                            pending = pending + 1
                            task.spawn(function()
                                validCache[id] = animLoads(animator, id)
                                pending = pending - 1
                            end)
                        end
                    end
                    local t0 = os.clock()
                    while pending > 0 and os.clock() - t0 < 6 do task.wait(0.1) end
                end
                if myToken ~= applyToken then return end -- người dùng đã chọn gói khác
                for key, id in pairs(pack) do
                    local slot = slots[key]
                    if slot then
                        if validCache[id] then
                            if origIds[slot] == nil then origIds[slot] = slot.AnimationId end
                            slot.AnimationId = "rbxassetid://" .. id
                            changed = true
                        else
                            failed = failed + 1
                        end
                    end
                end
            end

            if myToken ~= applyToken then return end

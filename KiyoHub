                P("ball", "ToeBack", V(0.1, 0.07, 0.22), orange, SP, bn, T(0, -0.95, 0.1))
            end

            local form = { center = 1.55, stride = 0.55, autoFly = true }
            form.update = function(dt)
                local t, m, ph, fa = M.t, M.m, M.phase, M.fa
                local open = clamp(fa + M.air * 0.9, 0, 1)
                local fold = 1 - open
                local freq = (fa > 0.1) and lerp(2.1, 3.6, M.fs) or 4.8
                fp = fp + dt * freq * 2 * pi
                local flapAmp = 0.62 * open

                local pitch = lerp(0.42, 0.04, fa) + 0.04 * sin(fp) * open + clamp(M.vy / 120, -0.25, 0.25) * fa
                local bob = 0.1 * abs(sin(ph)) * m * (1 - fa)
                B.body = T(0, 1.55 + 0.12 * sin(fp + 0.4) * open, 0) * Rz(M.bank * fa) * Rx(pitch)

                local idle = 1 - m
                local hy = sin(t * 1.3) * sin(t * 0.37) * 0.5 * idle + sin(t * 3.1) * 0.05 * idle
                local hpA = -pitch * 0.85 + sin(ph * 2) * 0.05 * m - 0.12 * fa
                local ht = sin(t * 0.7) * 0.1 * idle
                B.head = B.body * T(0, 0.55, -0.9) * Rx(hpA) * Ry(hy) * Rz(ht) * T(0, 0, -0.1 * sin(ph) * m)

                B.tail = B.body * T(0, -0.05, 0.95) * Rx(lerp(-0.35, 0.08, fa) + 0.06 * sin(t * 3) * (1 - fa) + 0.05 * sin(fp + 1) * open)

                local a1 = flapAmp * sin(fp) + 0.12 * open
                local a2 = flapAmp * 0.75 * sin(fp - 0.8)
                local a3 = flapAmp * 0.6 * sin(fp - 1.5)
                local s1, s2, s3 = 1.5 * fold, -3.0 * fold, 3.0 * fold
                for _, sx in ipairs(SIDES) do
                    local sdn = sd(sx)
                    local W1 = B.body * T(sx * 0.62, 0.28, -0.1) * Ry(-sx * s1) * Rz(sx * a1)
                    local W2 = W1 * T(sx * 1.5, 0, 0) * Ry(-sx * s2) * Rz(sx * a2)
                    local W3 = W2 * T(sx * 1.5, 0, 0) * Ry(-sx * s3) * Rz(sx * a3)
                    B["w1" .. sdn], B["w2" .. sdn], B["w3" .. sdn] = W1, W2, W3
                end

                local tuck = 1.4 * fa
                local sw = 0.7 * m * (1 - fa)
                B.legL = T(-0.32, 1.02, 0.15) * Rx(sw * sin(ph) - tuck)
                B.legR = T(0.32, 1.02, 0.15) * Rx(-sw * sin(ph) - tuck)

                local blink = (t % 3.1) < 0.12
                if blink ~= lastBlink then
                    lastBlink = blink
                    for i = 1, #lids do lids[i].Transparency = blink and 0 or 1 end
                end
                return bob, 0
            end
            return form
        end

        -- =====================================================================
        --  QUÁI VẬT (kinh dị, giật cục như stop-motion)
        -- =====================================================================
        Forms.Monster = function(r, H)
            local P, spike, B = H.P, H.spike, r.B
            local SL = MAT.Slate
            local CON = MAT.Concrete
            local SP = MAT.SmoothPlastic
            local skin, skinD, pale, bone = col(58, 48, 68), col(34, 28, 42), col(168, 160, 170), col(214, 208, 190)
            local mouthC, claw, black = col(110, 6, 16), col(22, 18, 24), col(4, 4, 6)
            local eyes = {}
            local S = { yaw = 0, tilt1 = 0, tilt2 = 0, headPitch = -0.2, jaw = 0.15, swing = 0, lean = 0.35, twist = 0, bob = 0, shudder = 0, elbow = 0.35, kL = 0.7, kR = 0.7, fing = {} }
            local nextStep = 0
            local screamT, airK = -1, 0
            local SCREAM_LEN = 3.0
            local BOOST_SPEED, BOOST_TIME = 30, 5
            local boostStart, boostEnd, rushK = 0, 0, 0
            local punchT, punchHit = -1, false
            local PUNCH_LEN, PUNCH_DMG, PUNCH_RANGE = 0.55, 20, 8
            local SCREAM_NEAR, SCREAM_MID, SCREAM_NEAR_DMG, SCREAM_MID_DMG = 12, 25, 5, 1
            local screamAcc = 0

            local hitSound = Instance.new("Sound")
            hitSound.Name = "PunchHit"
            hitSound.SoundId = "rbxassetid://7468131335"
            hitSound.Volume = 4
            hitSound.RollOffMaxDistance = 150
            hitSound.Parent = r.root

            -- chữ dame bay lên trên đầu mục tiêu
            local function floatDamage(part, amount)
                pcall(function()
                    local bb = Instance.new("BillboardGui")
                    bb.Size, bb.StudsOffset, bb.AlwaysOnTop = UDim2.new(0, 80, 0, 28), V(0, 3, 0), true
                    bb.Adornee = part
                    local tl = Instance.new("TextLabel", bb)
                    tl.Size, tl.BackgroundTransparency = UDim2.new(1, 0, 1, 0), 1
                    tl.Text, tl.TextColor3, tl.TextStrokeTransparency = "-" .. amount, Color3.fromRGB(255, 70, 70), 0.3
                    tl.Font, tl.TextSize = Enum.Font.GothamBlack, 20
                    bb.Parent = part
                    TweenService:Create(bb, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffset = V(0, 6, 0) }):Play()
                    TweenService:Create(tl, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
                    task.delay(0.85, function() pcall(function() bb:Destroy() end) end)
                end)
            end

            -- quét trúng: người chơi (mất máu giả, chỉ trên màn hình mày) + Davo's Mango + Lê Thô Sơ (mất máu thật, giết được)
            local function punchScan()
                local hrp = r.hrp
                if not (hrp and hrp.Parent) then return end
                local origin = hrp.Position
                local look = hrp.CFrame.LookVector
                local flatLook = V(look.X, 0, look.Z)
                if flatLook.Magnitude < 0.01 then return end
                flatLook = flatLook.Unit
                local hitAny = false

                for _, p in ipairs(Players:GetPlayers()) do
                    local ch = p ~= LocalPlayer and p.Character
                    if ch then
                        local th = ch:FindFirstChild("HumanoidRootPart")
                        local hu = ch:FindFirstChildOfClass("Humanoid")
                        if th and hu and hu.Health > 0 then
                            local to = th.Position - origin
                            local flat = V(to.X, 0, to.Z)
                            if flat.Magnitude <= PUNCH_RANGE and abs(to.Y) < 8
                                and (flat.Magnitude < 3 or flat.Unit:Dot(flatLook) > 0.4) then
                                hitAny = true
                                pcall(function() hu.Health = max(1, hu.Health - PUNCH_DMG) end)
                                floatDamage(th, PUNCH_DMG)
                            end
                        end
                    end
                end

                pcall(function()
                    local nb = ((getgenv and getgenv()) or _G).KiyoHubNPC
                    if nb and nb.hitMelee and nb.hitMelee(origin, flatLook, PUNCH_RANGE, PUNCH_DMG) > 0 then
                        hitAny = true
                    end
                end)

                if hitAny then
                    pcall(function()
                        hitSound.TimePosition = 0
                        hitSound:Play()
                    end)
                end
            end

            -- tiếng gào: mỗi 0.5s trừ máu mọi người xung quanh (người chơi: máu giả; Lê Thô Sơ / davo đang dí: máu thật)
            local function screamScan()
                local hrp = r.hrp
                if not (hrp and hrp.Parent) then return end
                local origin = hrp.Position
                for _, p in ipairs(Players:GetPlayers()) do
                    local ch = p ~= LocalPlayer and p.Character
                    if ch then
                        local th = ch:FindFirstChild("HumanoidRootPart")
                        local hu = ch:FindFirstChildOfClass("Humanoid")
                        if th and hu and hu.Health > 0 then
                            local to = th.Position - origin
                            local d = V(to.X, 0, to.Z).Magnitude
                            local dmg = (d <= SCREAM_NEAR and SCREAM_NEAR_DMG) or (d <= SCREAM_MID and SCREAM_MID_DMG) or 0
                            if dmg > 0 and abs(to.Y) < 12 then
                                pcall(function() hu.Health = max(1, hu.Health - dmg) end)
                                floatDamage(th, dmg)
                            end
                        end
                    end
                end
                pcall(function()
                    local nb = ((getgenv and getgenv()) or _G).KiyoHubNPC
                    if nb and nb.hitAura then nb.hitAura(origin, SCREAM_NEAR, SCREAM_MID, SCREAM_NEAR_DMG, SCREAM_MID_DMG) end
                end)
            end

            local screamSound = Instance.new("Sound")
            screamSound.Name = "Scream"
            screamSound.SoundId = "rbxassetid://84864462000645"
            screamSound.Volume = 5
            screamSound.RollOffMaxDistance = 200
            screamSound.Parent = r.root

            local function rnd(seed, k)
                local x = sin(seed * 12.9898 + k * 78.233) * 43758.5453
                return x - floor(x)
            end

            P("ball", "Pelvis", V(1.3, 0.95, 0.95), skinD, SL, "pelvis", IDENT)
            P("ball", "Abdomen", V(1.05, 1.3, 0.8), skin, SL, "chest", T(0, 0.5, 0))
            P("ball", "Chest", V(1.7, 1.75, 1.05), skin, SL, "chest", T(0, 1.4, 0))
            for i = 0, 3 do
                P("ball", "Rib", V(1.25, 0.1, 0.18), bone, CON, "chest", T(0, 0.95 + 0.28 * i, -0.46))
            end
            for i = 0, 5 do
                spike("Spine", bone, CON, "chest", T(0, 0.55 + 0.28 * i, 0.42) * Rx(1.05), 0.55 + 0.04 * i, 0.28, 3, 0.1)
            end

            -- cổ + đầu
            P("ball", "Neck", V(0.55, 1.4, 0.55), skinD, SL, "neck", T(0, 0.5, 0))
            P("ball", "Skull", V(1.05, 1.55, 1.15), pale, SL, "head", T(0, 0.55, -0.1))
            for _, sx in ipairs(SIDES) do
                P("ball", "Socket", V(0.42, 0.55, 0.3), black, SP, "head", T(sx * 0.27, 0.75, -0.52))
                local eye = P("ball", "Eye", V(0.22, 0.3, 0.14), Color3.new(1, 0.1, 0.1), MAT.Neon, "head", T(sx * 0.27, 0.75, -0.62))
                eyes[#eyes + 1] = eye
                P("ball", "Nostril", V(0.08, 0.16, 0.06), black, SP, "head", T(sx * 0.07, 0.3, -0.66))
                spike("Horn", bone, CON, "head", T(sx * 0.3, 1.05, -0.05) * Rz(-sx * 0.5) * Rx(0.35), 1.3, 0.2, 5, -0.16)
            end
            P("ball", "Mouth", V(0.75, 0.25, 0.9), mouthC, SP, "jaw", T(0, 0.05, -0.38))
            P("ball", "Jaw", V(0.8, 0.35, 0.95), pale, SL, "jaw", T(0, -0.1, -0.4))
            for i = 0, 5 do
                for _, sx in ipairs(SIDES) do
                    spike("TeethLow", bone, SP, "jaw", T(sx * (0.28 - 0.025 * i), 0.04, -0.2 - 0.12 * i), 0.24, 0.07, 2)
                end
            end
            for i = 0, 5 do
                for _, sx in ipairs(SIDES) do
                    spike("TeethUp", bone, SP, "head", T(sx * (0.3 - 0.02 * i), 0.05, -0.25 - 0.1 * i) * Rx(pi), 0.28, 0.07, 2)
                end
            end

            -- tay dài, ngón giật
            for _, sx in ipairs(SIDES) do
                local sdn = sd(sx)
                P("ball", "Shoulder", V(0.8, 0.8, 0.8), skinD, SL, "arm" .. sdn .. "S", IDENT)
                P("ball", "UpperArm", V(0.38, 1.7, 0.38), skin, SL, "arm" .. sdn .. "S", T(0, -0.8, 0))
                P("ball", "Elbow", V(0.45, 0.45, 0.45), skinD, SL, "arm" .. sdn .. "E", IDENT)
                P("ball", "Forearm", V(0.32, 1.8, 0.32), skin, SL, "arm" .. sdn .. "E", T(0, -0.9, 0))
                P("ball", "Palm", V(0.42, 0.5, 0.34), pale, SL, "arm" .. sdn .. "H", T(0, -0.15, 0))
                for f = 1, 4 do
                    local fx = (f - 2.5) * 0.11
                    local key = sdn .. f
                    S.fing[key] = 0.3
                    spike("Finger", claw, SP, "arm" .. sdn .. "H", function() return T(fx, -0.32, 0) * Rx(pi + S.fing[key]) end, 0.9, 0.1, 3, 0.25)
                end
            end

            -- chân khuỷu ngược
            for _, sx in ipairs(SIDES) do
                local sdn = sd(sx)
                P("ball", "Thigh", V(0.55, 1.65, 0.6), skin, SL, "hip" .. sdn, T(0, -0.8, 0))
                P("ball", "Knee", V(0.5, 0.5, 0.5), skinD, SL, "knee" .. sdn, IDENT)
                P("ball", "Shin", V(0.4, 1.6, 0.42), skin, SL, "knee" .. sdn, T(0, -0.8, 0))
                P("ball", "Foot", V(0.5, 0.28, 1.0), pale, SL, "foot" .. sdn, T(0, -0.1, -0.25))
                for c = -1, 1 do
                    spike("Toe", claw, SP, "foot" .. sdn, T(c * 0.16, -0.12, -0.7) * Rx(-pi / 2), 0.55, 0.13, 2, -0.3)
                end
            end

            -- xúc tu sau lưng
            for _, sx in ipairs(SIDES) do
                for i = 1, 7 do
                    local w = 0.24 - 0.025 * i
                    P("ball", "Tendril", V(w, w, 0.5), skinD, SL, "td" .. sd(sx) .. i, IDENT)
                end
            end

            local form = { center = 4.3, stride = 0.5 }
            form.update = function(dt)
                local t, m, ph, fa = M.t, M.m, M.phase, M.fa

                -- chỉ cập nhật tư thế ~12 lần/giây -> chuyển động giật cục rợn người
                -- chạy nhanh (sau khi hét): 0 -> 1 mượt
                local rushT = (t >= boostStart and t < boostEnd) and 1 or 0
                rushK = rushK + (rushT - rushK) * (1 - exp(-dt * 8))
                local rk = rushK * m

                if t >= nextStep then
                    nextStep = t + (rushK > 0.1 and 0.04 or 0.083)
                    local seed = floor(t * 0.5)
                    local idle = (1 - m) * (1 - fa)
                    S.yaw = (rnd(seed, 1) - 0.5) * 1.7 * idle
                    S.tilt1 = (rnd(seed, 2) - 0.5) * 0.7 * idle
                    S.tilt2 = (rnd(seed, 3) - 0.5) * 1.0 * idle
                    S.headPitch = -0.2 + (rnd(seed, 4) - 0.5) * 0.5 * idle + 0.1 * sin(ph) * m * (1 - rushK)
                    S.jaw = 0.1 + 0.12 * rnd(floor(t * 12), 5)
                    S.swing = (0.5 + 0.55 * rushK) * m * sin(ph)
                    S.lean = 0.35 + 0.15 * m + 0.4 * rk
                    S.twist = (0.18 + 0.12 * rushK) * m * sin(ph)
                    S.bob = (0.12 + 0.2 * rushK) * abs(sin(ph)) * m
                    S.shudder = (rnd(floor(t * 3), 6) > 0.8) and (((floor(t * 30) % 2) * 2 - 1) * 0.04) or 0
                    S.elbow = 0.3 + 0.15 * rnd(floor(t * 6), 7)
                    S.kL = 0.7 + (0.6 + 0.7 * rushK) * max(0, cos(ph)) * m
                    S.kR = 0.7 + (0.6 + 0.7 * rushK) * max(0, -cos(ph)) * m
                    for i = 1, 4 do
                        S.fing["L" .. i] = 0.25 + 0.6 * rnd(floor(t * 8), 10 + i)
                        S.fing["R" .. i] = 0.25 + 0.6 * rnd(floor(t * 8), 20 + i)
                    end
                end

                -- ===== hoạt ảnh mượt: gào (scream) + nhảy trên không =====
                local sk, crouch, jh = 0, 0, 0
                if screamT >= 0 then
                    screamT = screamT + dt
                    screamAcc = screamAcc + dt
                    if screamAcc >= 0.5 then
                        screamAcc = screamAcc - 0.5
                        pcall(screamScan)
                    end
                    local u = screamT / SCREAM_LEN
                    if u >= 1 then
                        screamT = -1
                    elseif u < 0.1 then
                        crouch = smooth(u / 0.1)
                        jh = -0.9 * crouch
                    elseif u < 0.3 then
                        local j = (u - 0.1) / 0.2
                        crouch = 1 - smooth(min(j * 3, 1))
                        sk = smooth(j)
                        jh = -0.9 * (1 - min(j * 4, 1)) + 3.4 * 4 * j * (1 - j)
                    elseif u < 0.85 then
                        sk = 1
                        jh = -0.25 * sin(clamp((u - 0.3) / 0.1, 0, 1) * pi)
                    else
                        sk = 1 - smooth((u - 0.85) / 0.15)
                    end
                end
                airK = airK + (M.air - airK) * (1 - exp(-dt * 12))
                local ak = airK * (1 - sk)
                local k2 = max(sk, ak)
                local shake = sin(t * 70) * 0.06 * sk

                if k2 > 0.4 then
                    for i = 1, 4 do
                        S.fing["L" .. i] = 0.95 + 0.1 * sin(t * 40 + i)
                        S.fing["R" .. i] = 0.95 + 0.1 * sin(t * 40 + i + 2)
                    end
                end

                -- ===== đấm: giơ tay phải lên (pw) rồi đập xuống (ps), trúng đòn ở giữa cú đập =====
                local pw, ps = 0, 0
                if punchT >= 0 then
                    punchT = punchT + dt
                    local u = punchT / PUNCH_LEN
                    if u >= 1 then
                        punchT = -1
                    elseif u < 0.35 then
                        pw = smooth(u / 0.35)
                    elseif u < 0.55 then
                        pw = 1 - smooth((u - 0.35) / 0.2)
                        ps = smooth((u - 0.35) / 0.2)
                    else
                        ps = 1 - smooth((u - 0.55) / 0.45)
                    end
                    if not punchHit and u >= 0.45 then
                        punchHit = true
                        pcall(punchScan)
                    end
                end

                local leanF = (lerp(lerp(S.lean, 0.1, ak), -0.4, sk) + 0.5 * crouch + 0.45 * ps - 0.15 * pw) * (1 - fa * 0.6)
                B.pelvis = T(0, 3.5 + min(jh, 0), 0) * Ry(S.twist)
                B.chest = B.pelvis * T(0, 0.35, 0) * Rx(-leanF) * Ry(-S.twist * 1.6 + S.shudder * (1 - sk) + 0.45 * pw - 0.5 * ps)
                B.neck = B.chest * T(0, 2.15, -0.15) * Rx(-0.5 + sin(t * 1.6) * 0.04 + 0.9 * sk + 0.5 * ak - 0.3 * crouch + 0.8 * rk) * Rz(S.tilt1 * (1 - k2))
                B.head = B.neck * T(0, 0.95, 0) * Rx(S.headPitch + 0.6 * sk + 0.35 * ak - 0.3 * crouch + 0.75 * rk) * Ry(S.yaw * (1 - k2) + shake) * Rz(S.tilt2 * (1 - k2))
                B.jaw = B.head * T(0, 0.05, -0.35) * Rx(-(S.jaw + 0.95 * sk + 0.35 * ak))

                for _, sx in ipairs(SIDES) do
                    local sdn = sd(sx)
                    local armSw = ((sx == 1) and S.swing or -S.swing) * 0.6
                    local base = lerp(armSw + 0.1, 1.35, fa)
                    local armX = lerp(lerp(base, 2.5, ak), 2.7, sk) - 0.6 * crouch
                    local elbowA = S.elbow + 0.5 * k2
                    local armZ = 0.12 + 0.7 * k2
                    if sx == 1 and (pw > 0 or ps > 0) then
                        armX = lerp(lerp(armX, 2.9, pw), 0.5, ps)
                        elbowA = lerp(lerp(elbowA, 1.0, pw), 0.05, ps)
                        armZ = lerp(armZ, 0.25, max(pw, ps))
                    end
                    B["arm" .. sdn .. "S"] = B.chest * T(sx * 1.05, 1.85, 0) * Rz(sx * armZ) * Rx(armX)
                    B["arm" .. sdn .. "E"] = B["arm" .. sdn .. "S"] * T(0, -1.6, 0) * Rx(elbowA)
                    B["arm" .. sdn .. "H"] = B["arm" .. sdn .. "E"] * T(0, -1.8, 0)

                    local legSw = (sx == -1) and S.swing or -S.swing
                    local th = lerp(0.3 + legSw, 0.15, fa) + 0.6 * ak + 0.5 * crouch
                    local kbBase = lerp((sx == -1) and S.kL or S.kR, 0.5, fa)
                    local kb = kbBase + 0.9 * ak + 0.8 * crouch + 0.3 * sk
                    B["hip" .. sdn] = B.pelvis * T(sx * 0.5, -0.35, 0) * Rx(th)
                    B["knee" .. sdn] = B["hip" .. sdn] * T(0, -1.55, 0) * Rx(-kb)
                    B["foot" .. sdn] = B["knee" .. sdn] * T(0, -1.55, 0) * Rx(-(th - kb))

                    -- xúc tu uốn lượn liên tục (quằn quại mạnh hơn khi gào / nhảy)
                    local F = B.chest * T(sx * 0.35, 1.5, 0.5) * Rx(-0.9 - 0.4 * k2)
                    local wild = 1 + 1.3 * k2 + 1.4 * rk
                    for i = 1, 7 do
                        F = F * Ry(sin(t * (2.2 + 3 * k2) - i * 0.8 + sx) * 0.28 * wild) * Rx(-0.18 + sin(t * (1.7 + 2 * k2) - i * 0.7) * 0.2 * wild)
                        B["td" .. sdn .. i] = F * T(0, 0, 0.25)
                        F = F * T(0, 0, 0.5)
                    end
                end

                local pulse = 0.5 + 0.5 * sin(t * (3.3 + 12 * sk + 10 * rushK))
                local ec = Color3.new(0.65 + 0.35 * pulse, 0.05 + 0.9 * math.max(sk, rushK * 0.6) * pulse, 0.05 + 0.9 * math.max(sk, rushK * 0.6) * pulse)
                for i = 1, #eyes do eyes[i].Color = ec end
                return S.bob + max(jh, 0), shake
            end
            -- tốc độ 30 trong 5 giây SAU KHI hét xong
            form.getSpeed = function()
                local n = os.clock()
                if n >= boostStart and n < boostEnd then return BOOST_SPEED end
                return nil
            end
            form.attack = {
                text = "PUNCH", cd = PUNCH_LEN + 0.05,
                fn = function()
                    if punchT >= 0 then return end
                    punchT, punchHit = 0, false
                end
            }
            form.action = {
                text = "SCREAM", cd = SCREAM_LEN + 0.1,
                fn = function()
                    boostStart = os.clock() + SCREAM_LEN
                    boostEnd = boostStart + BOOST_TIME
                    screamT, screamAcc = 0, 0
                    pcall(function()
                        screamSound.TimePosition = 0
                        screamSound:Play()
                    end)
                end
            }
            return form
        end

        -- =====================================================================
        --  RỒNG (khổng lồ, mạnh mẽ; đập cánh khi Fly; phun lửa)
        -- =====================================================================
        Forms.Dragon = function(r, H)
            local P, spike, B = H.P, H.spike, r.B

local rainParts, rainEmitters = {}, {}
local rainSpeed = 95
local rainFall = 60
local rainParams = RaycastParams.new()
rainParams.FilterType = Enum.RaycastFilterType.Exclude

local function destroyRain()
    for _, p in ipairs(rainParts) do pcall(function() p:Destroy() end) end
    rainParts, rainEmitters = {}, {}
end

-- Mỗi lớp mưa là 1 Part trong suốt phía trên đầu, phát hạt rơi xuống đất
local function makeRainLayer(areaSize, rate, particleSize, transparency)
    local p = Instance.new("Part")
    p.Name = "KiyoRain"
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    p.Transparency = 1
    p.Size = Vector3.new(areaSize, 1, areaSize)

    local lt = rainFall / rainSpeed
    local e = Instance.new("ParticleEmitter")
    e.Name = "KiyoRainEmitter"
    e.EmissionDirection = Enum.NormalId.Bottom
    e.Rate = rate
    e.Lifetime = NumberRange.new(lt * 0.95, lt * 1.05)
    e.Speed = NumberRange.new(rainSpeed * 0.9, rainSpeed * 1.1)
    e.Acceleration = Vector3.new(5, 0, 2) -- gió rất nhẹ
    e.SpreadAngle = Vector2.new(0, 0)
    e.Orientation = Enum.ParticleOrientation.FacingCamera -- vệt luôn thẳng đứng trên màn hình
    e.Size = NumberSequence.new(particleSize)
    e.Squash = NumberSequence.new(3)
    e.Transparency = NumberSequence.new(transparency)
    e.Color = ColorSequence.new(Color3.fromRGB(70, 130, 255))
    e.LightEmission = 0.15
    e.LightInfluence = 0.3
    e.Drag = 0
    e.Parent = p

    p.Parent = workspace.CurrentCamera or workspace
    table.insert(rainParts, p)
    table.insert(rainEmitters, e)
end

local function buildRain()
    destroyRain()
    makeRainLayer(46, 380, 1.4, 0.3)   -- lớp gần: dày, nhìn rõ
    makeRainLayer(180, 650, 2.4, 0.45) -- lớp xa: phủ rộng quanh người chơi
end

local rainAccum = 0.2
table.insert(Connections, RunService.RenderStepped:Connect(function(dt)
    if not State.Rain or #rainParts == 0 then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local pos = cam.CFrame.Position

    -- 5 lần/giây: dò mặt đất bên dưới để hạt mưa tắt đúng lúc chạm đất
    rainAccum = rainAccum + dt
    if rainAccum >= 0.2 then
        rainAccum = 0
        pcall(function()
            local char = LocalPlayer.Character
            rainParams.FilterDescendantsInstances = char and {char} or {}
            local hit = workspace:Raycast(pos, Vector3.new(0, -300, 0), rainParams)
            local fall = hit and (pos.Y + 35 - hit.Position.Y) or 70
            fall = math.clamp(fall, 20, 120)
            if math.abs(fall - rainFall) > 2 then
                rainFall = fall
                local lt = fall / rainSpeed
                for _, e in ipairs(rainEmitters) do
                    e.Lifetime = NumberRange.new(lt * 0.95, lt * 1.05)
                end
            end
        end)
    end

    local top = CFrame.new(pos + Vector3.new(0, 35, 0))
    for _, p in ipairs(rainParts) do p.CFrame = top end
end))


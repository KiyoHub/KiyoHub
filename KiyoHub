        local SubMorphBtn = createSubButton("SubMorphBtn", "ACT", UDim2.new(0.78, 0, 0.48, 0))

        -- nút phụ thứ hai: đánh (hiện khi dạng đang chọn có form.attack, hiện tại là Quái Vật)

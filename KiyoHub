        local function Ry(a) return CFrame.Angles(0, a, 0) end
        local function Rz(a) return CFrame.Angles(0, 0, a) end
        local sin, cos, abs, clamp, pi = math.sin, math.cos, math.abs, math.clamp, math.pi
        local max, min, floor, exp, sqrt = math.max, math.min, math.floor, math.exp, math.sqrt
        local function lerp(a, b, k) return a + (b - a) * k end
        local function smooth(k)
            k = clamp(k, 0, 1)
            return k * k * (3 - 2 * k)
        end
        local function col(r, g, b) return Color3.fromRGB(r, g, b) end
        local function sd(sx) return sx == 1 and "R" or "L" end
        local MAT = Enum.Material
        local IDENT = CFrame.new()
        local CYLROT = Rz(pi / 2)

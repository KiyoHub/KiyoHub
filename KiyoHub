            setDefaultHealth(false) -- một số game bật lại thanh máu mặc định
        end

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local hp, max = hum.Health, hum.MaxHealth

        for i = 1, 5 do
            local h = hearts[i]
            if h then
                local halfMark = (((i * 2) - 1) / 10) * max
                local fullMark = ((i * 2) / 10) * max
                local isHalf = (hp >= halfMark)
                local isFull = (hp >= fullMark)

                if h.lastIsHalf ~= isHalf or h.lastIsFull ~= isFull then
                    h.lastIsHalf, h.lastIsFull = isHalf, isFull
                    for _, px in pairs(h.left) do px.BackgroundColor3 = isHalf and RED or GRAY end
                    for _, px in pairs(h.right) do px.BackgroundColor3 = isFull and RED or GRAY end

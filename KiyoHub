            P("ball", "Belly", V(1.1, 0.7, 2.2), cream, SP, "body", T(0, -0.55, -0.2))
            P("ball", "Mid", V(1.2, 1.5, 2.0), orange, SP, "mid", T(0, 0, 0.55))
            P("ball", "MidBack", V(1.0, 0.7, 1.8), orangeD, SP, "mid", T(0, 0.45, 0.5))
            P("ball", "MidBelly", V(0.9, 0.6, 1.8), cream, SP, "mid", T(0, -0.45, 0.5))
            P("ball", "Rear", V(0.75, 1.0, 1.5), orange, SP, "rear", T(0, 0, 0.45))


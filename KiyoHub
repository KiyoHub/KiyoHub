                local isFn = type(off) == "function"
                if bone or isFn then
                    local f
                    if bone then
                        if isFn then
                            f = function() return B[bone] * off() * extra end
                        else
                            local o = off * extra
                            f = function() return B[bone] * o end
                        end
                    else
                        f = function() return off() * extra end
                    end
                    r.parts[#r.parts + 1] = { w = w, f = f }
                else
                    w.C0 = off * extra
                end
                w.Parent = p
            end

            -- shape: "ball" (elip), "block", "cyl" (trục Y)
            -- bone = tên khớp trong B (nil = gắn thẳng vào gốc), off = CFrame hoặc hàm trả về CFrame
            local function P(shape, name, size, color, mat, bone, off)
                local p = raw(shape, name, size, color, mat)
                attach(p, off or IDENT, bone, (shape == "cyl") and CYLROT or IDENT)
                return p
            end

            -- gai / sừng / vuốt: chuỗi elip thu nhỏ dần dọc trục +Y của `base`
            local function spike(name, color, mat, bone, base, length, thick, n, curve, flat)
                n = n or 3
                curve = curve or 0
                flat = flat or 1
                local seg = length / n
                local cur = IDENT
                for i = 1, n do
                    local d = thick * (1 - (i - 1) / n * 0.88)
                    local segCF = cur * T(0, seg / 2, 0)
                    local off
                    if type(base) == "function" then
                        off = function() return base() * segCF end
                    else
                        off = base * segCF
                    end
                    P("ball", name, V(d, seg * 1.4, d * flat), color, mat, bone, off)
                    cur = cur * T(0, seg, 0) * Rx(curve)
                end
            end

            return { P = P, spike = spike }
        end


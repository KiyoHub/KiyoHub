            local delay = math.max(tonumber(State.SpamDelay) or 5, 3) -- tối thiểu 3 giây giữa mỗi tin
            local waited = 0
            while waited < delay and Running and State.SpamChat and spamToken == myToken do
                task.wait(0.25)
                waited = waited + 0.25
            end
        end
    end)
end


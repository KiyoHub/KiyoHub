-- ==================== AUTO SAVE CONFIG SYSTEM ====================
local SAVE_FILE_NAME = "KiyoHub_Settings.json"
local AutoSaveEnabled = false
local SavedStateData = {}

local function LoadSavedConfig()
    pcall(function()
        if readfile and isfile and isfile(SAVE_FILE_NAME) then
            local content = readfile(SAVE_FILE_NAME)
            local data = HttpService:JSONDecode(content)
            if data then
                SavedStateData = data
                if data.AutoSave ~= nil then AutoSaveEnabled = data.AutoSave end
                if data.Language ~= nil then CurrentLanguage = data.Language end
            end
        end
    end)
end

local SkipSaveKeys = { LoopPeople = true, ToggleSpec = true, TargetFling = true, AutoSaveConfig = true, Freecam = true, SpamChat = true, Emote = true, GuideNPC = true }

local function SanitizeStates(states)
    local clean = {}
    for k, v in pairs(states) do
        local t = type(v)
        local isRuntime = type(k) ~= "string"
            or k:sub(-6) == "Active"
            or k:sub(-9) == "Selecting"
            or SkipSaveKeys[k]
        if not isRuntime and (t == "boolean" or t == "number" or t == "string") then
            clean[k] = v
        end
    end
    return clean
end

local function SaveCurrentConfig(currentStates, lang)
    pcall(function()
        if not AutoSaveEnabled then
            if delfile and isfile and isfile(SAVE_FILE_NAME) then
                delfile(SAVE_FILE_NAME)
            end
            return
        end
        if writefile then
            local dataToSave = {
                AutoSave = true,
                Language = lang,
                States = SanitizeStates(currentStates)
            }
            writefile(SAVE_FILE_NAME, HttpService:JSONEncode(dataToSave))
        end
    end)
end

local LANG_FILE_NAME = "KiyoHub_Language.json"
local OLD_LANG_FILE_NAME = "KiyoHub_Language.txt"
local function LoadSavedLanguage()
    pcall(function()
        if not (readfile and isfile) then return end
        if isfile(LANG_FILE_NAME) then
            local ok, data = pcall(function() return HttpService:JSONDecode(readfile(LANG_FILE_NAME)) end)
            if ok and type(data) == "table" and (data.Language == "English" or data.Language == "Vietnamese") then
                CurrentLanguage = data.Language
                return
            end
        end
        if isfile(OLD_LANG_FILE_NAME) then
            local lang = tostring(readfile(OLD_LANG_FILE_NAME)):gsub("%s+", "")
            if lang == "English" or lang == "Vietnamese" then CurrentLanguage = lang end
        end
    end)
end
local function SaveLanguage(lang)
    local ok = false
    pcall(function()
        if writefile then
            writefile(LANG_FILE_NAME, HttpService:JSONEncode({ Language = tostring(lang) }))
            -- đọc lại để chắc chắn đã ghi thành công
            if isfile and readfile and isfile(LANG_FILE_NAME) then
                local data = HttpService:JSONDecode(readfile(LANG_FILE_NAME))
                ok = (type(data) == "table" and data.Language == tostring(lang))
            else
                ok = true
            end
        end
    end)
    if not ok then
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Kiyo Hub",
                Text = "Không lưu được ngôn ngữ: executor không cho ghi file (writefile).",
                Duration = 5
            })
        end)
    end
end


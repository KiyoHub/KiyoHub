            fin(P("ball", "TailBot", V(0.08, 1.25, 1.2), finC, SP, "tail", T(0, -0.5, 0.85) * Rx(-0.5)), 0.15)

            -- đầu + hàm
            P("ball", "Snout", V(1.1, 1.2, 1.0), orange, SP, "head", T(0, 0, -0.2))
            P("ball", "SnoutTip", V(0.7, 0.7, 0.6), orange, SP, "head", T(0, -0.05, -0.65))
            P("ball", "Lip", V(0.5, 0.16, 0.45), cream, SP, "head", T(0, -0.3, -0.75))
            P("ball", "Jaw", V(0.55, 0.2, 0.65), cream, SP, "jaw", T(0, 0, -0.18))
            for _, sx in ipairs(SIDES) do
                P("ball", "EyeWhite", V(0.34, 0.34, 0.24), white, SP, "head", T(sx * 0.5, 0.22, -0.25))
                P("ball", "Pupil", V(0.2, 0.2, 0.16), dark, SP, "head", T(sx * 0.57, 0.22, -0.27))
                P("ball", "Glint", V(0.07, 0.07, 0.06), white, SP, "head", T(sx * 0.63, 0.28, -0.31))
                -- nắp mang (phập phồng khi thở)
                P("ball", "Gill", V(0.09, 0.8, 0.62), orangeD, SP, "gill" .. sd(sx), T(0, 0, 0.3))
                -- vây ngực
                fin(P("ball", "Pectoral", V(0.95, 0.07, 0.75), finC, SP, "fin" .. sd(sx), T(sx * 0.45, 0, 0.2)))
                -- vây bụng
                fin(P("ball", "Pelvic", V(0.55, 0.07, 0.5), finC, SP, "pel" .. sd(sx), T(sx * 0.25, 0, 0.18)))
            end

            -- vây lưng + vây hậu môn
            fin(P("ball", "Dorsal1", V(0.07, 0.85, 1.1), finC, SP, "dors1", T(0, 0.38, 0.1)))
            fin(P("ball", "Dorsal2", V(0.07, 0.7, 1.0), finC, SP, "dors2", T(0, 0.3, 0.1)))
            fin(P("ball", "Anal", V(0.07, 0.6, 0.9), finC, SP, "anal", T(0, -0.28, 0.1)))

            -- cảnh báo khi lên cạn
            local warnGui = Instance.new("BillboardGui")
            warnGui.Name = "FishDryWarn"
            warnGui.Adornee = r.root
            warnGui.Size = UDim2.new(0, 190, 0, 26)
            warnGui.StudsOffset = V(0, 3.8, 0)
            warnGui.AlwaysOnTop = true
            warnGui.Enabled = false
            warnGui.Parent = r.folder
            local warnLbl = Instance.new("TextLabel")
            warnLbl.Size, warnLbl.BackgroundTransparency = UDim2.new(1, 0, 1, 0), 1
            warnLbl.TextColor3, warnLbl.TextStrokeTransparency = Color3.fromRGB(255, 80, 80), 0.3
            warnLbl.Font, warnLbl.TextSize = Enum.Font.GothamBlack, 15
            warnLbl.Text = GetText("FishDry")
            warnLbl.Parent = warnGui

            local fp, flopT, wetK, pitchK, bankK = 0, 0, 1, 0, 0
            local wetCache, wetNext, dmgAcc, lastDry = true, 0, 0, false
            local psi = nil -- hướng mũi cá (yaw thế giới)

            -- ô terrain tại vị trí p có nước không
            local function waterAt(p)
                local ok, res = pcall(function()
                    local c = terrain:WorldToCell(p)
                    local cp = terrain:CellCenterToWorld(c.X, c.Y, c.Z)
                    local mats, occ = terrain:ReadVoxels(Region3.new(cp - V(2, 2, 2), cp + V(2, 2, 2)), 4)
                    return mats[1][1][1] == MAT.Water and occ[1][1][1] > 0.12
                end)
                return ok and res == true
            end

            -- đang ở môi trường bơi được: trạng thái Swimming, hoặc thân / chân đang ngập nước terrain
            local function isWet()
                local hrp, hum = r.hrp, r.hum
                if not (hrp and hrp.Parent and hum and hum.Parent) then return false end
                local okS, st = pcall(function() return hum:GetState() end)
                if okS and st == Enum.HumanoidStateType.Swimming then return true end
                local p = hrp.Position
                if waterAt(p) then return true end
                if waterAt(p - V(0, r.groundOffset * 0.8, 0)) then return true end
                return false
            end

            local form = { center = 1.3, stride = 0.65 }
            form.getSpeed = function()
                return wetCache and SWIM_SPEED or LAND_SPEED
            end

            form.update = function(dt)
                local t = M.t
                local hrp = r.hrp
                local v = hrp.AssemblyLinearVelocity
                local spd = V(v.X, 0, v.Z).Magnitude
                local sp3 = v.Magnitude

                if t >= wetNext then
                    wetNext = t + 0.1
                    wetCache = isWet()
                end
                local inWater = wetCache
                wetK = wetK + ((inWater and 1 or 0) - wetK) * (1 - exp(-dt * 7))
                local dry = 1 - wetK

                -- lên cạn: trừ 10 máu mỗi giây (chia thành nhịp 0.25s cho mượt)
                if inWater then
                    dmgAcc = 0
                else
                    dmgAcc = dmgAcc + dt
                    local n = 0
                    while dmgAcc >= TICK and n < 4 do
                        dmgAcc = dmgAcc - TICK
                        n = n + 1
                        local h = r.hum
                        if h and h.Parent and h.Health > 0 then
                            pcall(function() h:TakeDamage(DRY_DPS * TICK) end)
                        end
                    end
                end
                if lastDry == inWater then
                    lastDry = not inWater
                    warnGui.Enabled = lastDry
                    if lastDry then warnLbl.Text = GetText("FishDry") end
                end

                local moveK = clamp(sp3 / 22, 0, 1)
                fp = fp + dt * (2.6 + moveK * 7.5)
                flopT = flopT + dt * 8
                local ampW = 0.35 + 0.65 * moveK

                -- sóng uốn lượn khi bơi: đầu -> đuôi, mỗi đốt trễ pha hơn đốt trước
                local w0 = 0.05 * sin(fp) * ampW
                local w1 = 0.20 * sin(fp - 0.8) * ampW
                local w2 = 0.34 * sin(fp - 1.6) * ampW
                local w3 = 0.50 * sin(fp - 2.4) * ampW

                -- quẫy trên cạn: nằm nghiêng, nảy lên và quật đuôi
                local lift = max(0, sin(flopT))
                lift = lift * lift
                local fk = 0.30 + 0.75 * lift
                local d0 = 0.10 * sin(flopT * 2) * fk
                local d1 = 0.35 * sin(flopT * 2 - 0.7) * fk
                local d2 = 0.60 * sin(flopT * 2 - 1.4) * fk
                local d3 = 0.85 * sin(flopT * 2 - 2.1) * fk

                local y0, y1, y2, y3 = lerp(d0, w0, wetK), lerp(d1, w1, wetK), lerp(d2, w2, wetK), lerp(d3, w3, wetK)

                -- chúi đầu lên / xuống theo hướng bơi, nghiêng khi rẽ
                local pT = clamp(math.atan2(v.Y, max(spd, 4)), -0.85, 0.85)
                pitchK = pitchK + (pT - pitchK) * (1 - exp(-dt * 6))
                local av = hrp.AssemblyAngularVelocity.Y
                bankK = bankK + (clamp(av * 0.1, -0.5, 0.5) - bankK) * (1 - exp(-dt * 5))
                local roll = dry * (pi / 2 + 0.22 * sin(flopT)) + wetK * bankK
                local pitch = wetK * pitchK + dry * 0.05 * sin(flopT * 2)

                local bodyY = dry * (0.78 + 0.5 * lift) + wetK * 0.06 * sin(t * 1.7)
                -- khi bơi, Roblox cho HRP nằm sấp -> cá gắn theo HRP sẽ bị chúi đầu xuống.
                -- Tính khung "thẳng đứng + quay theo hướng bơi" rồi bù ngược lại cho HRP.
                local bob = wetK * (r.groundOffset - 0.15)
                local ry = -lerp(r.groundOffset, form.center, M.fa) + bob
                local hcf = hrp.CFrame
                local rootCF = hcf * T(0, ry, 0)
                local tgt = nil
                if hcf.UpVector.Y > 0.9 then
                    local lk = hcf.LookVector
                    if V(lk.X, 0, lk.Z).Magnitude > 0.1 then tgt = math.atan2(-lk.X, -lk.Z) end
                elseif spd > 2 then
                    tgt = math.atan2(-v.X, -v.Z)
                end
                if psi == nil then psi = tgt or 0 end
                if tgt then
                    local dd = math.atan2(sin(tgt - psi), cos(tgt - psi))
                    psi = psi + dd * (1 - exp(-dt * 9))
                end
                local K = rootCF:ToObjectSpace(T(hrp.Position + V(0, ry, 0)) * Ry(psi))
                B.body = K * T(0, bodyY, 0) * Rz(roll) * Rx(pitch) * Ry(y0)
                B.mid = B.body * T(0, 0, 0.7) * Ry(y1)
                B.rear = B.mid * T(0, 0, 1.35) * Ry(y2)
                B.tail = B.rear * T(0, 0, 0.95) * Ry(y3)

                -- đầu giữ thẳng hướng bơi, miệng + mang thở
                local bw = 0.5 + 0.5 * sin(t * 3)
                local bd = 0.5 + 0.5 * sin(t * 9)
                local jawOpen = wetK * (0.06 + 0.20 * bw) + dry * (0.15 + 0.55 * bd)
                local gillA = wetK * (0.08 + 0.12 * bw) + dry * (0.20 + 0.40 * bd)
                B.head = B.body * T(0, 0, -1.15) * Ry(-(y0 + y1 * 0.5)) * Rx(-pitch * 0.35)
                B.jaw = B.head * T(0, -0.3, -0.6) * Rx(-jawOpen)

                local flap = wetK * (0.25 * sin(fp * 1.1) + 0.1 + 0.2 * moveK) + dry * (0.7 * sin(flopT * 2.2))
                local sweep = wetK * (0.25 + 0.55 * moveK) + dry * 0.2
                for _, sx in ipairs(SIDES) do
                    local sdn = sd(sx)
                    B["gill" .. sdn] = B.head * T(sx * 0.52, -0.05, 0.05) * Ry(sx * gillA)
                    B["fin" .. sdn] = B.body * T(sx * 0.68, -0.3, -0.55) * Ry(-sx * sweep) * Rz(sx * flap)
                    B["pel" .. sdn] = B.body * T(sx * 0.35, -0.78, 0) * Rz(-sx * (0.6 + 0.15 * sin(fp + sx)))
                end

                B.dors1 = B.body * T(0, 0.78, -0.15) * Rz(0.12 * sin(fp - 0.3) * wetK + 0.08 * sin(flopT * 2) * dry) * Rx(0.2)
                B.dors2 = B.mid * T(0, 0.68, 0.4) * Rz(0.15 * sin(fp - 1.0) * wetK + 0.08 * sin(flopT * 2 - 1) * dry) * Rx(0.15)
                B.anal = B.mid * T(0, -0.68, 0.6) * Rz(-0.12 * sin(fp - 1.2) * wetK)

                -- trong nước: nâng thân ngang tầm HRP (không ngồi sát đất như lúc trên cạn)
                return bob, 0
            end
            return form
        end

        -- =====================================================================
        --  Lõi: dựng / hủy / cập nhật mỗi frame

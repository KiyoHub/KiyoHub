    local function jumpTo(tab, widget)
        SearchBox.Text = ""
        selectTab(tab)
        task.spawn(function()
            task.wait(0.05)
            pcall(function()
                local y = widget.AbsolutePosition.Y - tab.Scroll.AbsolutePosition.Y + tab.Scroll.CanvasPosition.Y
                tab.Scroll.CanvasPosition = Vector2.new(0, math.max(0, y - 6))
                local old = widget.BackgroundColor3
                widget.BackgroundColor3 = Color3.fromRGB(0, 100, 210)
                task.delay(0.9, function()
                    if widget.Parent then widget.BackgroundColor3 = old end
                end)
            end)
        end)
    end

    -- gom mọi tính năng đang có (Toggle/Input/Dropdown/Button) trong các tab
    local function collect()
        local list, seen = {}, {}
        for _, ui in ipairs(registeredUIElements) do
            if (ui.Type == "Label" or ui.Type == "Button") and ui.Object and ui.Object.Parent then
                local node, tab = ui.Object, nil
                while node and node.Parent do
                    for _, t in ipairs(Tabs) do
                        if node.Parent == t.Scroll then tab = t break end
                    end
                    if tab then break end
                    node = node.Parent
                end
                if tab and node and not seen[node] and node.Name ~= "SavedMusicList" then
                    seen[node] = true
                    list[#list + 1] = {
                        widget = node, tab = tab,
                        shown = GetText(ui.Key),
                        english = (Translations.English and Translations.English[ui.Key]) or ui.Key,
                    }
                end
            end
        end
        return list
    end

    local function clearResults()
        for _, c in ipairs(Results:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end
    end

    local function refresh()
        local raw = SearchBox.Text
        if raw:gsub("%s", "") == "" then
            Results.Visible = false
            clearResults()
            return
        end
        local q = fold(raw:gsub("^%s+", ""):gsub("%s+$", ""))
        clearResults()
        Results.Visible = true
        Results.CanvasPosition = Vector2.new(0, 0)
        local count = 0
        for _, e in ipairs(collect()) do
            if fold(e.shown):find(q, 1, true) or fold(e.english):find(q, 1, true) then
                count = count + 1
                local b = Instance.new("TextButton", Results)
                b.LayoutOrder = count
                b.Size = UDim2.new(1, -8, 0, 28)
                b.BackgroundColor3 = Color3.fromRGB(24, 30, 40)
                b.Text = "  " .. e.shown .. "   ·   " .. GetText(e.tab.NameKey)
                b.TextColor3 = Color3.fromRGB(230, 236, 248)
                b.Font = Enum.Font.GothamMedium
                b.TextSize = 11
                b.TextXAlignment = Enum.TextXAlignment.Left
                b.TextTruncate = Enum.TextTruncate.AtEnd
                b.ZIndex = 21
                Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
                b.MouseButton1Click:Connect(function() jumpTo(e.tab, e.widget) end)

                        if flyBg then flyBg:Destroy() end
                        flyBv = Instance.new("BodyVelocity", flyRootPart)
                        flyBv.Velocity, flyBv.MaxForce = Vector3.new(0, 0, 0), Vector3.new(math.huge, math.huge, math.huge)
                        flyBg = Instance.new("BodyGyro", flyRootPart)

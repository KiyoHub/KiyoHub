        -- bỏ dấu tiếng Việt để tìm kiếm dễ hơn
        local foldMap = {}
        local function addFold(chars, to)
            for _, cp in utf8.codes(chars) do foldMap[cp] = to end
        end
        addFold("àáạảãâầấậẩẫăằắặẳẵÀÁẠẢÃÂẦẤẬẨẪĂẰẮẶẲẴ", "a")
        addFold("èéẹẻẽêềếệểễÈÉẸẺẼÊỀẾỆỂỄ", "e")
        addFold("ìíịỉĩÌÍỊỈĨ", "i")
        addFold("òóọỏõôồốộổỗơờớợởỡÒÓỌỎÕÔỒỐỘỔỖƠỜỚỢỞỠ", "o")
        addFold("ùúụủũưừứựửữÙÚỤỦŨƯỪỨỰỬỮ", "u")
        addFold("ỳýỵỷỹỲÝỴỶỸ", "y")
        addFold("đĐ", "d")
        local function fold(s)
            s = tostring(s)
            local ok, res = pcall(function()
                local out = {}
                for _, cp in utf8.codes(s) do
                    local m = foldMap[cp]
                    if m then out[#out + 1] = m
                    elseif cp < 128 then out[#out + 1] = string.lower(string.char(cp))
                    else out[#out + 1] = utf8.char(cp) end
                end
                return table.concat(out)
            end)
            if ok then return res end
            return s:lower()
        end

        local function findGuide(raw)
            local trimmed = tostring(raw):gsub("^%s+", "")
            trimmed = trimmed:gsub("%s+$", "")
            local q = fold(trimmed)
            if #q < 2 then return nil end
            local bestScore, best = 0, {}
            for _, e in ipairs(GuideTexts) do
                local score = 0
                local names = { e[1], Translations.English[e[1]], Translations.Vietnamese[e[1]] }
                for _, nm in pairs(names) do
                    local f = fold(nm)
                    local s = 0
                    if f == q then s = 4
                    elseif f:find(q, 1, true) then s = 3
                    elseif #f >= 3 and q:find(f, 1, true) then s = 2 end
                    if s > score then score = s end
                end
                if score > bestScore then
                    bestScore, best = score, { e }
                elseif score == bestScore and score > 0 then
                    best[#best + 1] = e
                end
            end
            return best
        end


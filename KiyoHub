local function rainbowSequence(offset)
    local kps = {}
    for i = 0, 6 do
        kps[#kps + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV((offset + i / 6) % 1, 1, 1))
    end
    return ColorSequence.new(kps)
end

local function currentTrailColor(offset)
    local v = TrailColors[State.TrailColor]
    if v then return ColorSequence.new(Color3.fromRGB(v[1], v[2], v[3])) end
    return rainbowSequence(offset)
end


-- ==================== FREECAM ====================
-- ---------- Freecam ----------
local freecam = { pos = nil, pitch = 0, yaw = 0, conn = nil, hrp = nil, anchored = false, rmb = false, lookTouch = nil }

local function stopFreecam()
    if freecam.conn then freecam.conn:Disconnect() freecam.conn = nil end
    freecam.rmb, freecam.lookTouch = false, nil
    pcall(function()
        if freecam.hrp and freecam.hrp.Parent then freecam.hrp.Anchored = freecam.anchored end
        freecam.hrp = nil
        local cam = workspace.CurrentCamera
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if cam then
            cam.CameraType = Enum.CameraType.Custom
            if hum then cam.CameraSubject = hum end
        end
    end)
end

local function startFreecam()
    stopFreecam()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local pitch, yaw = cam.CFrame:ToOrientation()
    freecam.pitch, freecam.yaw, freecam.pos = pitch, yaw, cam.CFrame.Position
    cam.CameraType = Enum.CameraType.Scriptable
    freecam.conn = RunService.RenderStepped:Connect(function(dt)
        if not Running or not State.Freecam then return end
        pcall(function()
            local c = workspace.CurrentCamera
            if not c then return end
            if c.CameraType ~= Enum.CameraType.Scriptable then c.CameraType = Enum.CameraType.Scriptable end

            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp and hrp ~= freecam.hrp then
                freecam.hrp = hrp
                freecam.anchored = hrp.Anchored
                hrp.Anchored = true
            end

            local speed = math.clamp(tonumber(State.FreecamSpeed) or 50, 1, 500)
            local rot = CFrame.fromOrientation(freecam.pitch, freecam.yaw, 0)
            local move = Vector3.zero

            if hum and hum.MoveDirection.Magnitude > 0.01 then
                local md = hum.MoveDirection
                local look = rot.LookVector
                local flat = Vector3.new(look.X, 0, look.Z)
                if flat.Magnitude > 0.01 then
                    flat = flat.Unit
                    local right = flat:Cross(Vector3.new(0, 1, 0))
                    move = look * md:Dot(flat) + rot.RightVector * md:Dot(right)
                else
                    move = md
                end
            end

            if not UserInputService:GetFocusedTextBox() then
                if UserInputService:IsKeyDown(Enum.KeyCode.E) then move = move + Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.Q) then move = move - Vector3.new(0, 1, 0) end
            end

            freecam.pos = freecam.pos + move * speed * math.min(dt, 0.1)
            c.CFrame = CFrame.new(freecam.pos) * rot
            c.Focus = c.CFrame
        end)
    end)
end

table.insert(Connections, UserInputService.InputBegan:Connect(function(input, gp)
    if not State.Freecam then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        freecam.rmb = true
    elseif input.UserInputType == Enum.UserInputType.Touch and not gp and not freecam.lookTouch then
        local cam = workspace.CurrentCamera
        if cam and input.Position.X > cam.ViewportSize.X * 0.4 then freecam.lookTouch = input end
    end
end))

table.insert(Connections, UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        freecam.rmb = false
    elseif input == freecam.lookTouch then
        freecam.lookTouch = nil
    end
end))

table.insert(Connections, UserInputService.InputChanged:Connect(function(input)
    if not State.Freecam then return end
    local sens
    if input.UserInputType == Enum.UserInputType.MouseMovement and freecam.rmb then
        sens = 0.004
    elseif input == freecam.lookTouch then
        sens = 0.006
    else
        return
    end
    freecam.yaw = freecam.yaw - input.Delta.X * sens
    freecam.pitch = math.clamp(freecam.pitch - input.Delta.Y * sens, -1.5, 1.5)
end))


                for i = 1, 9 do
                    local sw = sin(t * 1.3 - i * 0.5) * (0.08 + 0.015 * i) * (0.8 + m * 0.9 + fa * 0.6)
                    TF = TF * Ry(sw) * Rx(lerp(0.025, 0, fa))
                    B["tail" .. i] = TF * T(0, 0, 0.75)
                    TF = TF * T(0, 0, 1.5)
